{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family tree data v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "people", "unions", "parentChild", "places"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "people": { "type": "object", "additionalProperties": { "$ref": "#/$defs/person" } },
    "unions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/union" } },
    "parentChild": { "type": "array", "items": { "$ref": "#/$defs/parentChild" } },
    "places": { "type": "object", "additionalProperties": { "$ref": "#/$defs/place" } }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "date": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-([0-2][0-9]|3[01]))?)?$" }
      ],
      "description": "Date shape only. JavaScript validator verifies real calendar dates."
    },
    "event": {
      "type": "object", "required": ["date", "placeId"], "additionalProperties": false,
      "properties": { "date": { "$ref": "#/$defs/date" }, "placeId": { "$ref": "#/$defs/nullableString" } }
    },
    "person": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "sex", "birth", "death", "image", "notes"],
      "properties": {
        "id": { "type": "string" },
        "name": {
          "type": "object", "additionalProperties": false,
          "required": ["given", "surname", "birthSurname", "suffix", "display"],
          "properties": {
            "given": { "type": "string" }, "surname": { "type": "string" },
            "birthSurname": { "$ref": "#/$defs/nullableString" },
            "suffix": { "$ref": "#/$defs/nullableString" },
            "display": { "$ref": "#/$defs/nullableString" }
          }
        },
        "sex": { "enum": ["female", "male", "other", "unknown", null] },
        "birth": { "$ref": "#/$defs/event" }, "death": { "$ref": "#/$defs/event" },
        "image": { "$ref": "#/$defs/nullableString" }, "notes": { "type": "string" }
      }
    },
    "union": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "partnerIds", "type", "start", "end"],
      "properties": {
        "id": { "type": "string" },
        "partnerIds": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "type": { "enum": ["marriage", "partnership", "unknown"] },
        "start": { "$ref": "#/$defs/event" },
        "end": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["date", "placeId", "reason"], "additionalProperties": false,
              "properties": {
                "date": { "$ref": "#/$defs/date" },
                "placeId": { "$ref": "#/$defs/nullableString" },
                "reason": { "enum": ["divorce", "separation", "death", "other", "unknown"] }
              }
            }
          ]
        }
      }
    },
    "parentChild": {
      "type": "object", "additionalProperties": false,
      "required": ["parentId", "childId", "type"],
      "properties": {
        "parentId": { "type": "string" }, "childId": { "type": "string" },
        "type": { "enum": ["biological", "adoptive", "step", "unknown"] },
        "unionId": { "type": "string" }
      }
    },
    "place": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "latitude", "longitude"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string", "minLength": 1 },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
      }
    }
  }
}
